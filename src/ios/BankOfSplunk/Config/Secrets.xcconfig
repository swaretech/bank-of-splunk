// Shared defaults for local development and CI.
// GitHub Actions overrides SPLUNK_RUM_ACCESS_TOKEN and API_BASE_URL at build time.
// For local telemetry, replace SPLUNK_RUM_ACCESS_TOKEN with your RUM token (do not commit tokens).

API_BASE_URL = http:/$()/127.0.0.1:8083
MARKETING_VERSION = 1.2.0
SPLUNK_RUM_REALM = us1
SPLUNK_RUM_ACCESS_TOKEN = disabled
SPLUNK_RUM_APP_NAME = bank-of-splunk-ios
SPLUNK_RUM_DEPLOYMENT_ENVIRONMENT = bank-local
