// Copy to Secrets.xcconfig and fill in your Splunk RUM credentials.
// Secrets.xcconfig is gitignored — never commit real tokens.
//
// Debug.xcconfig / Release.xcconfig include this file and only override API_BASE_URL.
//
// ── Splunk RUM iOS agent parameters (AgentConfiguration / EndpointConfiguration) ──
// Official docs pass these directly to SplunkRum.install(with:). This project maps
// xcconfig → Info.plist → AppConfig → AgentConfiguration.
//
// | Splunk install() parameter | xcconfig key (Secrets)        | Info.plist key                  | RUM resource attribute   |
// |----------------------------|-------------------------------|---------------------------------|--------------------------|
// | realm                      | SPLUNK_RUM_REALM              | SplunkRumRealm                  | (ingest routing)         |
// | rumAccessToken             | SPLUNK_RUM_ACCESS_TOKEN       | SplunkRumAccessToken            | (ingest auth)            |
// | appName                    | SPLUNK_RUM_APP_NAME           | SplunkRumAppName                | app                      |
// | deploymentEnvironment      | SPLUNK_RUM_DEPLOYMENT_ENVIRONMENT | SplunkRumDeploymentEnvironment | deployment.environment |
// | appVersion (optional)      | MARKETING_VERSION             | CFBundleShortVersionString      | app.version              |
//
// UI filters use resource attributes app and deployment.environment — not app.name.

API_BASE_URL = http:/$()/127.0.0.1:8083
MARKETING_VERSION = 1.2.0
SPLUNK_RUM_REALM = us0
SPLUNK_RUM_ACCESS_TOKEN = disabled
SPLUNK_RUM_APP_NAME = bank-of-splunk-ios
SPLUNK_RUM_DEPLOYMENT_ENVIRONMENT = bank-local
