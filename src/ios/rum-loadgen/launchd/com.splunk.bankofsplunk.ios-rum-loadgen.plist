<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.splunk.bankofsplunk.ios-rum-loadgen</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>REPO_ROOT/src/ios/rum-loadgen/scripts/run-all.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>HOME/Library/Logs/bank-of-splunk/ios-rum-loadgen.log</string>
	<key>StandardErrorPath</key>
	<string>HOME/Library/Logs/bank-of-splunk/ios-rum-loadgen.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</key>
		<key>RUM_LOADGEN_SIMULATOR</key>
		<string>iPhone 17</string>
		<key>RUM_LOADGEN_START_APPIUM</key>
		<string>1</string>
	</dict>
</dict>
</plist>
